# Copy this file to .env.production and fill in real values. Never commit
# .env.production itself - it is gitignored.
#
# Used by: docker-compose.prod.yml (api, worker, beat, web share this file;
# postgres reads only the POSTGRES_* vars below).
#
# Before/at startup, the api and worker/beat services validate this file's
# values (not just presence) and refuse to start if APP_ENV=production and a
# critical check fails - see services/api/app/core/env_validation.py and its
# worker mirror services/worker/worker/env_validation.py. Check the result of
# any already-running deployment at any time via:
#   curl -H "X-Admin-Token: $ADMIN_TOKEN" https://<api-host>/admin/env-check
# See "Production required env vars" in docs/deployment.md for the full rule
# list and docs/operations.md for how to rotate ADMIN_TOKEN.
#
# Deploy flow once this file is filled in: `make prod-build && make prod-up
# && make prod-migrate && ADMIN_TOKEN=<token> make prod-smoke` - see "Quick
# deploy flow" in docs/deployment.md. `make prod-verify` sanity-checks
# docker-compose.prod.yml itself (config/build) without needing this file to
# exist yet or any real secrets.

APP_ENV=production

# Must point at the `postgres` service below - keep the user/password/db in
# sync with POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB. This is a placeholder
# shape, not a working default - replace change-me before deploying. Must NOT
# contain the default local dev password (opcg:opcg) - env_validation.py
# fails startup in production if it does.
DATABASE_URL=postgresql+psycopg://opcg:change-me@postgres:5432/opcg
REDIS_URL=redis://redis:6379/0

# Required in production - the API and worker/beat refuse to start without
# it when APP_ENV=production. Must not be the local-dev default
# ('local-dev-admin-token', used by the repo-root .env for local dev only)
# and must be at least 32 characters. Generate with e.g. `openssl rand -hex
# 32`. See "How to rotate ADMIN_TOKEN" in docs/deployment.md.
ADMIN_TOKEN=change-me

# Required in production (same check as ADMIN_TOKEN above). Shared between
# api and web - the web app mints a bearer token with this secret in its
# NextAuth session callback (apps/web/src/lib/auth.ts), and the api verifies
# it (services/api/app/auth.py::require_current_user). Never reuse AUTH_SECRET
# for this - generate independently, e.g. `openssl rand -base64 33`.
API_JWT_SECRET=change-me

# Locks CORS down to the deployed frontend instead of the dev default "*" -
# see services/api/app/main.py. Set to your Vercel production domain; the
# regex additionally covers Vercel's per-PR preview deployments.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# Host port `web` is published on (docker-compose.prod.yml) - change if 3000
# is already taken on the host. api/postgres/redis are never published to
# the host by default; put a reverse proxy in front of web for a real
# domain/TLS. See "Starting production services" in docs/deployment.md.
WEB_PORT=3000

# Postgres container credentials. DATABASE_URL above must match these.
POSTGRES_DB=opcg
POSTGRES_USER=opcg
POSTGRES_PASSWORD=change-me

# mock or live - mock is the safe default; live sends real requests to
# Yuyu-Tei/SNKRDUNK. When live, YUYUTEI_REQUEST_DELAY_MS and
# SNKRDUNK_REQUEST_DELAY_MS must both be >= 1000 (enforced at worker/beat
# startup in production).
SCRAPING_MODE=live
YUYUTEI_REQUEST_DELAY_MS=3000
SNKRDUNK_REQUEST_DELAY_MS=3000
PRICE_REFRESH_INTERVAL_HOURS=6

# --- Telegram config -------------------------------------------------------
# Optional - both or neither. If only one is set, the worker logs a warning
# and skips sending alerts in development, and fails startup in production
# (see services/worker/worker/alerts/telegram.py and env_validation.py).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Market workflow schedule config ---------------------------------------
# Disabled by default - Celery Beat never runs the scheduled market
# intelligence workflow unless MARKET_WORKFLOW_ENABLED=true (see
# services/worker/worker/celery_app.py::_build_beat_schedule). If enabled and
# MARKET_WORKFLOW_SEND_TELEGRAM=true, TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID
# above must both be set.
MARKET_WORKFLOW_ENABLED=false
# all, yuyutei, or snkrdunk
MARKET_WORKFLOW_SOURCE=yuyutei
# Blank runs the full mapping set; otherwise a positive integer.
MARKET_WORKFLOW_LIMIT=
MARKET_WORKFLOW_SEND_TELEGRAM=false
# UTC hour (0-23) / minute (0-59) Celery Beat schedules the run at.
MARKET_WORKFLOW_HOUR_UTC=0
MARKET_WORKFLOW_MINUTE_UTC=0

# Baked into the web image at build time (Next.js NEXT_PUBLIC_* vars are
# inlined at `next build`, not read at container runtime) - must be set
# before `docker compose -f docker-compose.prod.yml build web`. Never put a
# secret in a NEXT_PUBLIC_* variable - apps/web/scripts/check-env.js fails
# the production build/start if one looks like a token/secret/password/key.
NEXT_PUBLIC_API_URL=

# Server-side only (never NEXT_PUBLIC_) - the web app's Next.js API routes
# (src/app/api/**) use this to reach the api container directly instead of
# through NEXT_PUBLIC_API_URL, which points at a public/browser-facing URL.
# Required in production - see apps/web/scripts/check-env.js.
API_INTERNAL_URL=http://api:8000

# Auth.js's own session-encryption secret - generate with `openssl rand -base64 33`.
AUTH_SECRET=change-me
# From a Google Cloud OAuth 2.0 Client ID (Web application). Authorized
# redirect URI must be <your-web-origin>/api/auth/callback/google. See
# docs/deployment.md for setup steps.
AUTH_GOOGLE_ID=change-me
AUTH_GOOGLE_SECRET=change-me
