# Copy this file to .env.production and fill in real values. Never commit
# .env.production itself - it is gitignored.
#
# Used by: docker-compose.prod.yml (api, worker, beat, web share this file;
# postgres reads only the POSTGRES_* vars below).

APP_ENV=production

# Must point at the `postgres` service below - keep the user/password/db in
# sync with POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB. This is a placeholder
# shape, not a working default - replace change-me before deploying.
DATABASE_URL=postgresql+psycopg://opcg:change-me@postgres:5432/opcg
REDIS_URL=redis://redis:6379/0

# Required in production - the API refuses to start without it when
# APP_ENV=production (see services/api/app/config_check.py).
ADMIN_TOKEN=change-me

# Required in production (same check as ADMIN_TOKEN above). Shared between
# api and web - the web app mints a bearer token with this secret in its
# NextAuth session callback (apps/web/src/lib/auth.ts), and the api verifies
# it (services/api/app/auth.py::require_current_user). Never reuse AUTH_SECRET
# for this - generate independently, e.g. `openssl rand -base64 33`.
API_JWT_SECRET=change-me

# Locks CORS down to the deployed frontend instead of the dev default "*" -
# see services/api/app/main.py. Set to your Vercel production domain; the
# regex additionally covers Vercel's per-PR preview deployments.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# Postgres container credentials. DATABASE_URL above must match these.
POSTGRES_DB=opcg
POSTGRES_USER=opcg
POSTGRES_PASSWORD=change-me

SCRAPING_MODE=live
YUYUTEI_REQUEST_DELAY_MS=3000
SNKRDUNK_REQUEST_DELAY_MS=3000
PRICE_REFRESH_INTERVAL_HOURS=6

# Optional - if either is set without the other, the worker logs a warning
# and Telegram alerts are skipped (see services/worker/worker/alerts/telegram.py).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Baked into the web image at build time (Next.js NEXT_PUBLIC_* vars are
# inlined at `next build`, not read at container runtime) - must be set
# before `docker compose -f docker-compose.prod.yml build web`.
NEXT_PUBLIC_API_URL=

# Auth.js's own session-encryption secret - generate with `openssl rand -base64 33`.
AUTH_SECRET=change-me
# From a Google Cloud OAuth 2.0 Client ID (Web application). Authorized
# redirect URI must be <your-web-origin>/api/auth/callback/google. See
# docs/deployment.md for setup steps.
AUTH_GOOGLE_ID=change-me
AUTH_GOOGLE_SECRET=change-me
