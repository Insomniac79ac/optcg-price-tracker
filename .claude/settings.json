{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(railway:*)",
      "Bash(npx railway:*)",
      "Bash(npx @railway/cli:*)",
      "Bash(printenv)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(set)",
      "Bash(export -p)",
      "Bash(declare -p)",
      "Bash(declare -x)",
      "Bash(gh auth token:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable set:*)",
      "Bash(gh variable delete:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin staging)",
      "Bash(git push origin staging:*)",
      "Bash(git push origin HEAD:staging)",
      "Bash(git push origin HEAD:refs/heads/staging)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
