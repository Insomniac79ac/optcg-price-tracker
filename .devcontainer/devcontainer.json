{
  "name": "CardPirate Atlas",
  "image": "mcr.microsoft.com/devcontainers/universal:5.1.5-noble",
  "remoteUser": "codespace",
  "remoteEnv": {
    "VIRTUAL_ENV": "/home/codespace/.venvs/cardpirate",
    "PATH": "/home/codespace/.venvs/cardpirate/bin:/home/codespace/.local/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash scripts/codespaces/bootstrap.sh",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/home/codespace/.venvs/cardpirate/bin/python"
      }
    }
  }
}
