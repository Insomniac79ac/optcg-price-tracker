# Railway-only build for the isolated Yuyu-Tei feasibility spike. Not used by
# local Docker Compose, not referenced by any application service, and not
# part of the app's own deploy path (see docs/railway_staging.md, which
# governs the api/worker/beat services - this file is unrelated to that).
#
# Deployed to its own temporary, isolated Railway project: no Postgres, no
# Redis, no shared service, no application secrets. This build runs the
# single live validation of extractor v3 (see spike.py's
# "single_validation" mode / run_single_live_validation()): one homepage
# request, then - only if that homepage is a genuine normal HTTP 200 - one
# product request, one extraction, evidence saved, exit. No repeated
# product requests, no 12-check reliability loop (that mode - "
# static_ip_reliability" / run_static_ip_reliability_pipeline() - still
# exists in spike.py for manual use but is not what this image runs).
#
# Base image pins the exact browser build that matches requirements.txt's
# `playwright==1.61.0` (confirmed via `docker manifest inspect
# mcr.microsoft.com/playwright/python:v1.61.0-jammy`), so no browser
# download happens at container start - only `pip install` at build time.
#
# Built with this file's own directory as build context (Root Directory =
# spikes/yuyutei-browser-feasibility on the Railway service), so COPY paths
# below are relative to this spike directory, not the repo root.
#
# Local verification (run from this directory):
#   docker build -f Dockerfile.railway -t yuyutei-railway-spike-test .
#   docker run --rm yuyutei-railway-spike-test python spike.py --mode single_validation

FROM mcr.microsoft.com/playwright/python:v1.61.0-jammy

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY spike.py .

CMD ["python", "spike.py", "--mode", "single_validation"]
