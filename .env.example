DATABASE_URL=postgresql+psycopg://opcg:opcg@postgres:5432/opcg
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development
SCRAPING_MODE=mock
YUYUTEI_REQUEST_DELAY_MS=3000
PRICE_REFRESH_INTERVAL_HOURS=6
SNKRDUNK_REQUEST_DELAY_MS=3000
SNKRDUNK_AUTO_MATCH_THRESHOLD=0.92
PROJECT_ROOT=
SNKRDUNK_SEED_FILE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_TOKEN=
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Per-user auth (Google login via NextAuth/Auth.js) ---------------------
# Shared between the api and web services - must be identical on both, since
# the web app mints a bearer token with this secret and the api verifies it
# (see services/api/app/auth.py::require_current_user and
# apps/web/src/lib/auth.ts). Never reuse AUTH_SECRET for this.
API_JWT_SECRET=
# Auth.js's own session-encryption secret - generate with `openssl rand -base64 33`.
AUTH_SECRET=
# From a Google Cloud OAuth 2.0 Client ID (Web application) - see
# docs/deployment.md for setup steps. Authorized redirect URI must be
# <your-web-origin>/api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
