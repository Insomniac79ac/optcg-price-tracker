+        assert storage.encode_new_snapshot(session, child)
+        session.commit()
+        assert child.raw_content == mock_body()
+        assert (
+            session.scalar(
+                text(
+                    "SELECT base_snapshot_id FROM raw_snapshot_dictionaries WHERE id=:id"
+                ),
+                {"id": child.id},
+            )
+            == base.id
+        )
+        other = row()
+        session.add(other)
+        assert not storage.encode_new_snapshot(
