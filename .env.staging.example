# Staging deployment template - Vercel (frontend, apps/web) + Railway (api,
# worker, beat, managed Postgres, managed Redis). See docs/staging_deployment.md
# for the full architecture writeup and docs/railway_staging.md /
# docs/staging_checklist.md for the deploy runbook.
#
# This file is a REFERENCE ONLY - there is no single place that reads it as a
# whole. Split it by platform:
#   - "Frontend/Vercel" section  -> Vercel project's Environment Variables
#     (Settings -> Environment Variables), for the "Preview"/staging
#     environment.
#   - "Backend/Railway" + "Workflow" + "Telegram" sections -> each Railway
#     service's Variables tab (api, worker, beat) - see docs/railway_staging.md
#     for exactly which vars go on which service.
#
# Never commit a real `.env.staging` file (only this `.example` file is
# tracked - see .gitignore and scripts/check_secrets.sh). Nothing below is a
# real secret - every value is a placeholder or a documented safe default.

# =============================================================================
# Frontend / Vercel (apps/web) - Root Directory = apps/web in the Vercel
# project settings. See docs/staging_deployment.md section "Vercel services".
# =============================================================================

# Server-side + build-time marker for this deployment's environment. Not
# currently read by any frontend code path (no code branches on it today) -
# set it anyway so it shows up in Vercel's env var list and in logs/debugging,
# and so it's ready if/when a check starts reading it. Never a secret.
APP_ENV=staging

# Client-bundle-visible mirror of APP_ENV above (NEXT_PUBLIC_* vars are
# inlined into the browser JS at build time - see apps/web/scripts/check-env.js).
# Same "not read anywhere yet, but harmless and future-ready" status as
# APP_ENV above. Never put a secret in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_APP_ENV=staging

# Public HTTPS URL of the Railway "api" service (e.g.
# https://opcg-api-staging.up.railway.app). This is the SAME public URL for
# both of the vars below - there is no separate "internal-only" Railway URL
# reachable from Vercel's build/runtime, so both point at the one public
# endpoint. Do not point either of these at a Railway *private* networking
# hostname (those only resolve between Railway services on the same project,
# not from Vercel).
API_BASE_URL=https://<railway-api-staging-url>
# Read server-side only by apps/web/src/app/api/** route handlers (never
# NEXT_PUBLIC_*) to reach the backend. Falls back to http://api:8000 (the
# docker-compose service DNS name) when unset, which only works inside the
# local Docker Compose network - always set this explicitly for Vercel.
API_INTERNAL_URL=https://<railway-api-staging-url>

# Prefer leaving this unset/blank and relying on the server-side proxy routes
# under apps/web/src/app/api/** (which use API_INTERNAL_URL above) instead.
# Set it only if you still need the handful of pages that call the backend
# directly from the browser (see "Known direct backend calls to fix before
# production" in docs/staging_deployment.md) - those specifically read
# NEXT_PUBLIC_API_URL, not API_BASE_URL. If set, it must be a URL the browser
# can actually reach (the same Railway public URL as above), and it gets
# baked into the client bundle at build time (rebuild required to change it).
# Never set it to a bare "/api" path - the direct calls this covers do not go
# through the Next.js proxy layer.
NEXT_PUBLIC_API_URL=

# Do NOT set ADMIN_TOKEN (or any NEXT_PUBLIC_ADMIN_TOKEN) here. The admin
# token is entered by the operator in the browser UI and stored in
# localStorage (see getAdminToken/setAdminToken in apps/web/src/lib/api.ts),
# then forwarded as an X-Admin-Token header by server-side route handlers -
# it is never a Vercel environment variable.

# =============================================================================
# Backend / Railway - shared across the api, worker, and beat services unless
# noted otherwise. See docs/railway_staging.md for the per-service breakdown.
# =============================================================================

APP_ENV=staging

# Railway's managed Postgres plugin injects its own DATABASE_URL as a bare
# postgresql:// string - rewrite the scheme to postgresql+psycopg:// (this
# app uses sync SQLAlchemy via psycopg, not an async driver) before setting
# it here. Prefer Railway's private/internal networking URL (service-to-
# service, not billed/counted as external egress) over the public one when
# available - see docs/railway_staging.md.
DATABASE_URL=<railway-postgres-url>

# Railway's managed Redis plugin's private/internal URL, same reasoning as
# DATABASE_URL above.
REDIS_URL=<railway-redis-url>

# Generate with `openssl rand -hex 32` and set directly in each Railway
# service's Variables tab - never commit the real value. Required by api;
# worker/beat only need it if a specific internal job calls admin-token-gated
# endpoints (none do by default in this codebase).
ADMIN_TOKEN=change-me

# mock is the safe default for the first staging deploy - no real requests
# to Yuyu-Tei/SNKRDUNK. Do not switch to "live" until api/worker/beat have
# been verified stable on staging (see docs/staging_checklist.md). Never
# attempt a SNKRDUNK live-scrape bypass of site protections - SNKRDUNK data
# only ever enters this app via manual candidate import, regardless of this
# setting.
SCRAPING_MODE=mock
YUYUTEI_REQUEST_DELAY_MS=3000
SNKRDUNK_REQUEST_DELAY_MS=3000
PRICE_REFRESH_INTERVAL_HOURS=6

# Celery's --concurrency defaults to the HOST's CPU count, not the
# container's actual allocation - on a small Railway instance this showed up
# as "concurrency: 48 (prefork)" in the worker logs and crash-looped the
# service (OOM-killed, no Python traceback). Only read by the worker service
# (deploy/railway/worker.Dockerfile) - beat runs a single scheduler process
# with no prefork pool, so --concurrency doesn't apply there; api doesn't
# use Celery workers either. Keep this low (1-2) for staging.
WORKER_CONCURRENCY=2

# Same shared-secret requirement as production - see docs/deployment.md
# section 10 (Per-user auth). Must be identical on the Railway api service
# and the Vercel web service (as API_JWT_SECRET there too). Generate with
# `openssl rand -hex 32`, distinct from ADMIN_TOKEN.
API_JWT_SECRET=change-me

CACHE_ENABLED=true
CACHE_BACKEND=redis

# Lock CORS down to the Vercel staging domain(s) - see services/api/app/main.py.
CORS_ALLOWED_ORIGINS=https://<vercel-staging-domain>
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Workflow (beat schedule / worker jobs) ---------------------------------
# Disabled by default for the first staging deploy - see
# docs/staging_deployment.md "Safety". Only relevant to the beat service
# (schedules) and worker service (executes); api does not read these.
MARKET_WORKFLOW_ENABLED=false
MARKET_WORKFLOW_SOURCE=yuyutei
MARKET_WORKFLOW_LIMIT=25
MARKET_WORKFLOW_SEND_TELEGRAM=false
DATA_RETENTION_ENABLED=false

# --- Telegram ----------------------------------------------------------------
# Omit entirely, or point at a staging-only test channel/bot - never the
# production bot/channel. Both or neither (see docs/deployment.md section 1b).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google OAuth (per-user login) ------------------------------------------
# A separate OAuth client from production, with the staging Vercel domain's
# callback URL authorized (<vercel-staging-domain>/api/auth/callback/google).
# See docs/deployment.md section 10.
AUTH_SECRET=change-me
AUTH_GOOGLE_ID=change-me
AUTH_GOOGLE_SECRET=change-me
